      <guid>http://localhost:1313/%E8%AE%A1%E7%AE%97%E6%9C%BA%E5%9F%BA%E7%A1%80/%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84%E4%B8%8E%E7%AE%97%E6%B3%95/%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84%E4%B8%8E%E7%AE%97%E6%B3%95%E5%88%86%E6%9E%90-java%E8%AF%AD%E8%A8%80%E6%8F%8F%E8%BF%B0%E7%AC%94%E8%AE%B0/</guid>
      <category domain="http://localhost:1313/categories/%E8%AE%A1%E7%AE%97%E6%9C%BA%E5%9F%BA%E7%A1%80---%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84%E4%B8%8E%E7%AE%97%E6%B3%95/">计算机基础 - 数据结构与算法</category>
      <description>&lt;p&gt;第3章 表、栈和队列&lt;/p&gt;&#xA;&lt;p&gt;3.2.1 表的简单数组实现&lt;/p&gt;&#xA;&lt;pre&gt;&lt;code&gt;int [] arr = new int[10];&#xA;    int [] newArr = new int[arr.length*2];&#xA;    for(int i = 0; i &amp;lt; arr.length; i&amp;#43;&amp;#43;)&#xA;        newArr[i] = arr[i];&#xA;    arr = newArr;&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;表Lists&lt;/p&gt;&#xA;&lt;pre&gt;&lt;code&gt;List&amp;lt;String&amp;gt; arrayList = new ArrayList&amp;lt;&amp;gt;();&#xA;//顺序表&#xA;List&amp;lt;Integer&amp;gt; linkList = new LinkedList&amp;lt;&amp;gt;();&#xA;//链表&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;集合Sets&lt;/p&gt;&#xA;&lt;pre&gt;&lt;code&gt;Set&amp;lt;String&amp;gt; hashSet = new HashSet&amp;lt;&amp;gt;();&#xA;/*&#xA;* 无序集合，基于HashMap实现&#xA;* 高效的查找和插入操作&#xA;* 不保证顺序&#xA;*/&#xA;Set&amp;lt;String&amp;gt; treeSet = new TreeSet&amp;lt;&amp;gt;();&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;3.2.2 简单链表&lt;/p&gt;</description>
    </item>
